[
 {
  "doctype": "Print Format",
  "name": "AIO Phiếu Thu",
  "doc_type": "AI Office Document Request",
  "module": "VN Office AI",
  "print_format_type": "Jinja",
  "standard": "Yes",
  "custom_format": 1,
  "disabled": 0,
  "font_size": 0,
  "margin_top": 15,
  "margin_bottom": 15,
  "margin_left": 15,
  "margin_right": 15,
  "html": "\n<style>\n.aio-vch { font-family: \"Times New Roman\", serif; font-size: 13pt; padding: 8px 16px; }\n.aio-vch-top { display: flex; justify-content: space-between; align-items: flex-start; }\n.aio-vch-form { text-align: right; font-size: 10pt; font-style: italic; }\n.aio-vch-title { text-align: center; font-size: 18pt; font-weight: bold; margin: 6px 0 2px; }\n.aio-vch-sub { text-align: center; font-style: italic; margin-bottom: 10px; }\n.aio-vch-row { margin: 4px 0; }\n.aio-vch-label { display: inline-block; min-width: 160px; }\n.aio-vch-sign { display: flex; justify-content: space-between; margin-top: 28px; text-align: center; }\n.aio-vch-sign div { width: 19%; font-size: 11pt; }\n.aio-vch-sign .aio-role { font-weight: bold; }\n.aio-vch-sign .aio-hint { font-style: italic; font-size: 9pt; }\n</style>\n\n{% set v = doc.get_values_dict() %}\n<div class=\"aio-vch\">\n  <div class=\"aio-vch-top\">\n    <div>{{ doc.company or \"\" }}</div>\n    <div class=\"aio-vch-form\">Mẫu số 01-TT<br>(Ban hành theo TT 200/2014/TT-BTC)</div>\n  </div>\n  <div class=\"aio-vch-title\">PHIẾU THU</div>\n  <div class=\"aio-vch-sub\">Ngày {{ v.get(\"voucher_date\") or \".....\" }}</div>\n  <div class=\"aio-vch-row\">Số: {{ doc.name }}</div>\n  <div class=\"aio-vch-row\">Nợ TK 111 &nbsp;&nbsp; Có TK 131</div>\n  <div class=\"aio-vch-row\"><span class=\"aio-vch-label\">Họ tên người nộp tiền:</span> {{ v.get(\"payer\") or \"\" }}</div>\n  <div class=\"aio-vch-row\"><span class=\"aio-vch-label\">Địa chỉ:</span> {{ v.get(\"payer_address\") or \"\" }}</div>\n  <div class=\"aio-vch-row\"><span class=\"aio-vch-label\">Lý do:</span> {{ v.get(\"reason\") or \"\" }}</div>\n  <div class=\"aio-vch-row\"><span class=\"aio-vch-label\">Số tiền:</span> {{ format_vnd(v.get(\"amount\")) }} đồng</div>\n  <div class=\"aio-vch-row\"><span class=\"aio-vch-label\">Bằng chữ:</span> <i>{{ so_tien_bang_chu(v.get(\"amount\")) }}</i></div>\n  <div class=\"aio-vch-row\"><span class=\"aio-vch-label\">Kèm theo:</span> {{ v.get(\"attachment_count\") or \"\" }} chứng từ gốc</div>\n  <div class=\"aio-vch-sign\">\n    <div><div class=\"aio-role\">Giám đốc</div><div class=\"aio-hint\">(Ký, họ tên)</div></div>\n    <div><div class=\"aio-role\">Kế toán trưởng</div><div class=\"aio-hint\">(Ký, họ tên)</div></div>\n    <div><div class=\"aio-role\">Người lập</div><div class=\"aio-hint\">(Ký, họ tên)</div></div>\n    <div><div class=\"aio-role\">Người nộp</div><div class=\"aio-hint\">(Ký, họ tên)</div></div>\n    <div><div class=\"aio-role\">Thủ quỹ</div><div class=\"aio-hint\">(Ký, họ tên)</div></div>\n  </div>\n</div>\n"
 },
